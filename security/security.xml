<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

    <!-- ═══════════════════════════════════════════════════════
         MODULE CATEGORY
    ═══════════════════════════════════════════════════════ -->
    <record id="module_category_petapantau" model="ir.module.category">
        <field name="name">PetaPantau</field>
        <field name="sequence">50</field>
    </record>

    <!-- Odoo 19: privilege layer between category and groups -->
    <record id="privilege_petapantau_access" model="res.groups.privilege">
        <field name="name">PetaPantau</field>
        <field name="category_id" ref="module_category_petapantau"/>
        <field name="sequence">10</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         GROUPS
         Hierarki:
           group_petapantau_user  ← base teknikal (implied oleh semua grup)
           group_admin          → implies group_petapantau_user
           group_subdit         → implies group_petapantau_user
           group_polres         → implies group_petapantau_user
           group_polsek         → implies group_petapantau_user
         Satu user hanya boleh berada di SATU grup operasional.
    ═══════════════════════════════════════════════════════ -->

    <!-- Base group: teknikal, tidak muncul di form user -->
    <record id="group_petapantau_user" model="res.groups">
        <field name="name">Pengguna PetaPantau</field>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_petapantau_access"/>
        <field name="implied_ids" eval="[(4, ref('petapantau.group_petapantau_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_subdit" model="res.groups">
        <field name="name">Subdit</field>
        <field name="privilege_id" ref="privilege_petapantau_access"/>
        <field name="implied_ids" eval="[(4, ref('petapantau.group_petapantau_user'))]"/>
    </record>

    <record id="group_polres" model="res.groups">
        <field name="name">Polres</field>
        <field name="privilege_id" ref="privilege_petapantau_access"/>
        <field name="implied_ids" eval="[(4, ref('petapantau.group_petapantau_user'))]"/>
    </record>

    <record id="group_polsek" model="res.groups">
        <field name="name">Polsek</field>
        <field name="privilege_id" ref="privilege_petapantau_access"/>
        <field name="implied_ids" eval="[(4, ref('petapantau.group_petapantau_user'))]"/>
    </record>

    <!-- Subdit Patroli: khusus DITLANTAS dan DITSAMAPTA.
         Implies group_subdit → user yang pilih ini otomatis dapat semua hak Subdit
         + akses aplikasi mobile Patroli tanpa polres (atas nama Polda).
         Admin cukup pilih "Subdit Patroli" (bukan "Subdit") untuk user tsb. -->
    <record id="group_subdit_patroli" model="res.groups">
        <field name="name">Subdit Patroli</field>
        <field name="privilege_id" ref="privilege_petapantau_access"/>
        <field name="implied_ids" eval="[
            (4, ref('petapantau.group_subdit')),
            (4, ref('petapantau.group_petapantau_user')),
        ]"/>
    </record>


    <!-- Dashboard Viewer: hanya baca semua data dashboard, menu Maps saja. -->
    <record id="group_viewer" model="res.groups">
        <field name="name">Dashboard Viewer</field>
        <field name="privilege_id" ref="privilege_petapantau_access"/>
        <field name="implied_ids" eval="[(4, ref('petapantau.group_petapantau_user'))]"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         RECORD RULES
         Admin tidak butuh record rule (akses global via ir.model.access).
         Polres/Polsek/Subdit difilter via domain user.xxx_id.id.
         Jika field org belum diisi admin → domain '= False' → hanya
         melihat record yang juga tidak punya field tersebut (minimal risk).
    ═══════════════════════════════════════════════════════ -->

    <!-- ─── Polres ─────────────────────────────────────────── -->
    <record id="rule_polres_polres" model="ir.rule">
        <field name="name">Polres: hanya polres sendiri</field>
        <field name="model_id" ref="model_petapantau_polres"/>
        <field name="domain_force">[('id', '=', user.polres_id.id)]</field>
        <field name="groups" eval="[(4, ref('petapantau.group_polres'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

